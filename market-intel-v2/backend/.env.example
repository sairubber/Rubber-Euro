# No API key required to run this app — Google News RSS and GDELT need nothing at all.

# Optional — powers a supplementary real-news source alongside the free
# scrapers (get a free key at https://newsapi.org).
NEWS_API_KEY=

# Optional — raises the free MyMemory translation API's quota from 5,000 to
# 50,000 words/day. Leave blank to use the anonymous tier.
TRANSLATE_EMAIL=

# Optional — the scraper runs continuously; these just control the gap
# between passes (in minutes/hours), not whether it runs.
REFRESH_MINUTES=10
CLIMATE_REFRESH_HOURS=3
DATABASE_URL=sqlite:///./market_intel.db
CORS_ORIGINS=http://localhost:5173

# aisstream.io free API key (register at aisstream.io) - powers Vessel Watch
AISSTREAM_KEY=
