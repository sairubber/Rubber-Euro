# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# market-intel-v2 (Python backend + React frontend)
market-intel-v2/backend/.venv/
market-intel-v2/backend/__pycache__/
market-intel-v2/backend/**/__pycache__/
market-intel-v2/backend/*.db
# SQLite WAL mode writes these sidecars alongside the .db — they hold real
# committed data, so `*.db` alone is not enough to keep the database out.
market-intel-v2/backend/*.db-shm
market-intel-v2/backend/*.db-wal
market-intel-v2/backend/.env
market-intel-v2/frontend/dist/
# Generated knowledge-graph output (rebuildable with /graphify, and its
# cache/ subtree is large and machine-specific)
market-intel-v2/graphify-out/
